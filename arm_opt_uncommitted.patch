+# 动态发现所有 can 接口（USB-CAN 枚举顺序会变，can0/can1/can2 都可能）
+can_ifaces() {
+    ls /sys/class/net 2>/dev/null | grep -E '^can[0-9]+$' | sort
+}
+
+# gs_usb USB-CAN 复位：固件偶发 USB 超时/bitrate 失败死锁，unbind/bind 重启驱动恢复
+reset_gs_usb() {
+    local id
+    for id in $(ls /sys/bus/usb/drivers/gs_usb/ 2>/dev/null | grep ':1\.0$'); do
+        echo "  [gs_usb] resetting $id"
+        sudo sh -c "echo '$id' > /sys/bus/usb/drivers/gs_usb/unbind" 2>/dev/null || true
+        sleep 1
+        sudo sh -c "echo '$id' > /sys/bus/usb/drivers/gs_usb/bind" 2>/dev/null || true
+        sleep 2
+    done
+}
+
+# 将单个 can 接口 up 到可探测状态；已 UP 则不动（避免频繁 down/up 触发 gs_usb 固件死锁）
+iface_up_ok() {
+    local iface=$1
+    local st
+    st=$(ip -br link show "$iface" 2>/dev/null | awk '{print $2}')
+    if [ "$st" != "UP" ]; then
+        # 接口未 up：重置（清 BUS-OFF）后重新 up
+        sudo ip link set "$iface" down 2>/dev/null || true
+        sleep 0.3
+        sudo ip link set "$iface" up type can bitrate 1000000 restart-ms 100 2>/dev/null || true
+        sleep 0.8
+        st=$(ip -br link show "$iface" 2>/dev/null | awk '{print $2}')
+    fi
+    [ "$st" = "UP" ] || return 1
+    if ip -details link show "$iface" 2>/dev/null | grep -q 'BUS-OFF\|NO-CARRIER'; then
+        return 1
+    fi
+    return 0
+}
 
