    - Class: rviz_default_plugins/Image
      Enabled: false
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: Image
      Normalize Range: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: yolo/crop_rgb
      Value: true
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: Yolo Target Box
      Namespaces:
        grasp_target_box: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: yolo/target_box
      Value: true
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: Grasp Target Marker
      Namespaces:
        grasp_target: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: grasp_target_marker
      Value: true
    - Class: rviz_default_plugins/Marker
