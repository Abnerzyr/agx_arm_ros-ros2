[Unit]
Description=AGX Arm stack (production, no rviz)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=s1
ExecStart=/bin/bash /home/s1/tiaozhanbei/agx_arm_ros-ros2/start_arm_auto.sh
Restart=always
RestartSec=10
TimeoutStopSec=30
KillMode=control-group

[Install]
WantedBy=multi-user.target
